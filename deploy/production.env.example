# Images DockerHub à pousser puis à renseigner dans Dokploy.
BACKEND_IMAGE=docker.io/ciacems/vel:backend-latest
FRONTEND_IMAGE=docker.io/ciacems/vel:frontend-latest

# Ports internes exposés au reverse proxy Dokploy.
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Runtime backend.
APP_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL Dokploy service.
# Service interne Dokploy: vel-postgres-7dverw
# Database: vel_db
# User: postgres_vel
POSTGRES_HOST=vel-postgres-7dverw
POSTGRES_PORT=5432
POSTGRES_DB=vel_db
POSTGRES_USER=postgres_vel
POSTGRES_PASSWORD=replace-with-dokploy-postgres-password
DATABASE_URL=postgres://postgres_vel:replace-with-dokploy-postgres-password@vel-postgres-7dverw:5432/vel_db

# Redis Dokploy service.
# Service interne Dokploy: vel-redis-xju9f1
# User: default
REDIS_HOST=vel-redis-xju9f1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-dokploy-redis-password
REDIS_URL=redis://default:replace-with-dokploy-redis-password@vel-redis-xju9f1:6379

# JWT: utiliser deux secrets différents, longs et aléatoires.
JWT_ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-64-random-chars
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-64-random-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Sécurité auth/cookies.
# Les cookies doivent être Secure en prod et partagés sur le domaine racine pour le CSRF.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.vendeursenlive.shop
CSRF_PROTECTION_ENABLED=true
CORS_ALLOWED_ORIGINS=https://vendeursenlive.shop
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Reset password: ne jamais exposer les tokens en prod.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_EXPOSE_PASSWORD_RESET_TOKEN=false

# Migrations.
RUN_MIGRATIONS_ON_START=true

# TikTok Login Kit.
# Regénérer le secret TikTok avant la prod si l'ancien a été partagé.
TIKTOK_CLIENT_KEY=replace-with-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://api.vendeursenlive.shop/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic
TIKTOK_AUTH_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/
TIKTOK_SUCCESS_REDIRECT_URL=https://vendeursenlive.shop/app

# Logs.
RUST_LOG=vendeursenlive_backend=info,actix_web=info,sea_orm=warn
