# En local, utilise le même host que celui ouvert dans le navigateur:
# - frontend http://localhost:5173  -> backend http://localhost:8080
# - frontend http://127.0.0.1:5173 -> backend http://127.0.0.1:8080
VITE_API_BASE_URL=http://localhost:8080
# Le domaine localhost n'est pas accepte par l'allowlist TikTok LIVE Embed.
VITE_TIKTOK_LIVE_EMBED_ENABLED=false

# Google OAuth utilise un flux serveur. Le client secret ne doit jamais etre expose a Vite.
