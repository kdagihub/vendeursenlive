APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vendeursenlive
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_TOKEN_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_EXPOSE_PASSWORD_RESET_TOKEN=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CSRF_PROTECTION_ENABLED=true
RUN_MIGRATIONS_ON_START=true
TIKTOK_CLIENT_KEY=replace-with-local-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-local-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8080/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic
TIKTOK_AUTH_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/
TIKTOK_SUCCESS_REDIRECT_URL=http://localhost:5173/app
RUST_LOG=vendeursenlive_backend=debug,actix_web=info,sea_orm=info
